# Variables de entorno opcionales. No hace falta copiar esto a un .env
# para uso local (todas tienen default razonable) — es solo referencia
# para deploy (ej. Railway).

# Puerto donde escucha el servidor. Railway lo inyecta solo; en local el
# launcher de escritorio (iniciar_buscador.command) usa 5050.
# PORT=5050

# Prende el modo debug de Flask (auto-reload + debugger interactivo).
# Nunca activarlo en un servidor expuesto a internet (ej. Railway): el
# debugger permite ejecutar código arbitrario si alguien llega a un error
# sin atrapar. El launcher de escritorio ya lo prende para uso local.
# FLASK_DEBUG=1

# Dónde guardar favoritos.json. Por default se guarda en la raíz del
# proyecto. En Railway el disco del contenedor es efímero (se borra en
# cada redeploy) salvo que montes un volumen persistente — en ese caso
# apuntá esto a una ruta dentro del volumen, ej. /data/favoritos.json.
# FAVORITOS_PATH=/data/favoritos.json
